alias k=kubectl
alias ls='ls --color'
alias ll='ls -lha --color'
alias mkd="mkdir -pv"
alias reload="exec zsh"
alias restow="stow -R -d ${HOME}/Projects/dotfiles -t ${HOME} dotfiles"
